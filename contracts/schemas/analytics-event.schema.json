{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.smartcart.invalid/analytics-event.schema.json",
  "title": "AnalyticsEvent",
  "description": "Frozen analytics taxonomy (v1). No PII: no user ID, email, address, order ID, item names or free text.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event", "at", "install_id", "session_id", "props"],
  "properties": {
    "schema_version": { "const": 1 },
    "event": {
      "enum": [
        "screen_view",
        "auth_register_result",
        "auth_login_result",
        "auth_recovery_requested",
        "auth_logout",
        "home_month_changed",
        "category_selected",
        "chat_message_sent",
        "chat_clarification_answered",
        "comparison_requested",
        "comparison_viewed",
        "comparison_provider_chosen",
        "comparison_switch_confirmed",
        "automation_consent_changed",
        "task_approved",
        "task_checkpoint_answered",
        "task_stopped",
        "task_terminal",
        "handoff_opened",
        "manual_fallback_shown",
        "history_import_started",
        "history_import_finished",
        "suggestion_opened",
        "suggestion_feedback",
        "privacy_action",
        "session_revoked",
        "notification_opened",
        "consent_changed",
        "email_verification_result"
      ]
    },
    "at": { "type": "string", "format": "date-time" },
    "install_id": { "type": "string", "description": "Random per-install pseudonymous ID; reset on data deletion." },
    "session_id": { "type": "string" },
    "app_version": { "type": "string" },
    "props": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "screen": { "type": "string", "pattern": "^S-[A-Z]+-[0-9]{2}$" },
        "result": { "enum": ["success", "failure", "cancelled"] },
        "error_code": { "type": "string" },
        "category": { "enum": ["travel", "food", "grocery", "shopping"] },
        "provider": { "type": "string", "pattern": "^[a-z_]+$" },
        "recommended_provider": { "type": "string", "pattern": "^[a-z_]+$" },
        "comparison_status": { "type": "string" },
        "objective": { "type": "string" },
        "providers_checked": { "type": "integer", "minimum": 0 },
        "task_status": { "type": "string" },
        "stop_reason": { "enum": ["emergency_stop", "user_cancel", "pause_all"] },
        "decision": { "enum": ["approve", "reject"] },
        "granted": { "type": "boolean" },
        "consent_scope": { "enum": ["automation", "history", "ai_processing", "notifications", "terms", "privacy"] },
        "privacy_action": { "enum": ["export", "delete_history", "delete_chat", "delete_account", "clear_cache", "privacy_mode_changed"] },
        "useful": { "type": "boolean" },
        "line_count": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "handoff_strategy": { "enum": ["cart_deep_link", "app_launch", "manual"] },
        "notification_type": { "enum": ["cart_ready", "needs_user_action", "import_complete", "monthly_summary"] },
        "degraded": { "type": "boolean" }
      }
    }
  }
}
