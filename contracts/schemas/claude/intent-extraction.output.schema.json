{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.smartcart.invalid/claude/intent-extraction.output.schema.json",
  "title": "ClaudeIntentExtractionOutput",
  "description": "Backend-only. Claude output is rejected unless it validates. Fields that try to grant permissions, skip confirmation or start payment do not exist and are rejected by additionalProperties:false.",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent_type", "category", "provider", "entities", "ride", "clarification_needed", "clarification_question", "clarification_options", "reply_text", "confidence"],
  "properties": {
    "intent_type": { "enum": ["order", "book_ride", "view_summary", "suggest_purchase", "import_history", "general", "unknown"] },
    "category": { "enum": ["travel", "food", "grocery", "shopping", null] },
    "provider": { "type": ["string", "null"], "description": "Must be one of the installed_providers given in input, else null. Validated server-side." },
    "entities": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "quantity", "size", "modifiers"],
        "properties": {
          "name": { "type": "string", "maxLength": 120 },
          "quantity": { "type": ["integer", "null"], "minimum": 1, "maximum": 50 },
          "size": { "type": ["string", "null"], "maxLength": 40 },
          "modifiers": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 60 } }
        }
      }
    },
    "ride": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["pickup_label", "drop_label", "ride_class"],
      "properties": {
        "pickup_label": { "type": ["string", "null"], "maxLength": 120 },
        "drop_label": { "type": ["string", "null"], "maxLength": 120 },
        "ride_class": { "enum": ["bike", "auto", "mini", "sedan", "suv", "any", null] }
      }
    },
    "clarification_needed": { "type": "boolean" },
    "clarification_question": { "type": ["string", "null"], "maxLength": 200 },
    "clarification_options": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 60 } },
    "reply_text": { "type": "string", "maxLength": 600 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
