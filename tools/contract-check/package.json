{
  "name": "contract-check",
  "private": true,
  "type": "module",
  "description": "Lint the OpenAPI contract, validate fixtures and schemas, and run the Prism mock server.",
  "scripts": {
    "fixtures": "node generate-fixtures.mjs",
    "lint": "spectral lint ../../contracts/openapi/openapi.yaml --ruleset .spectral.yaml --fail-severity warn",
    "validate": "node validate.mjs",
    "check": "npm run fixtures && npm run lint && npm run validate",
    "mock": "prism mock ../../contracts/openapi/openapi.yaml --port 4010 --dynamic=false"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "5.16.0",
    "@stoplight/spectral-cli": "6.17.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  }
}
