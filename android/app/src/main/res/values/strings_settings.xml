    <string name="help_q_unknown_screen">A task stopped on an unfamiliar screen</string>
    <string name="help_a_unknown_screen">Apps change their screens. SmartCart stops rather than guess. Finish in the app yourself; your list is shown on the next screen.</string>
    <string name="help_q_price">The price in the app is different</string>
    <string name="help_a_price">Comparisons are estimates checked at a point in time. The app always shows the final price before you pay.</string>
    <string name="help_q_otp">The app asked me to sign in or enter an OTP</string>
    <string name="help_a_otp">SmartCart never enters passwords or OTPs. Do it yourself, then tap Resume.</string>
    <string name="help_q_cart">I can\'t find my cart</string>
    <string name="help_a_cart">Open the app and tap its cart icon. Some apps don\'t support opening the cart directly.</string>

