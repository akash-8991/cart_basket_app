<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Phase 4.1: the runtime may check that the allowlisted app is installed and genuinely signed. -->
    <queries>
        <package android:name="com.smartcart.teststore" />
    </queries>
    <application android:networkSecurityConfig="@xml/network_security_config">
        <!-- Debug builds only until the Play AccessibilityService policy review (R-01) is done. -->
        <service
            android:name="com.smartcart.app.automation.SmartCartAutomationService"
            android:exported="false"
            android:label="@string/automation_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/automation_service" />
        </service>
    </application>
</manifest>
